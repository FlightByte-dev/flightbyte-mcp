  "info": {
    "title": "FlightByte API",
    "description": "Flight status lookups and signed webhooks for every change. Look a flight up by carrier, number and date, or subscribe to it and receive a webhook each time something about it changes.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "flights",
      "description": "Look flights up, pick a leg, read the timeline."
    },
    {
      "name": "subscriptions",
      "description": "Watch a flight and receive every change as a webhook."
    },
    {
      "name": "countries",
      "description": "Country names, emoji and SVG flags for airport data."
    }
  ],
  "servers": [
    {
      "url": "https://api.flightbyte.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Your FlightByte API key. Request one at https://flightbyte.dev/get-api-key."
      }
    },
    "schemas": {
      "CarrierRef": {
        "type": "object",
        "properties": {
          "iata": {
            "type": "string",
            "example": "TK"
          },
          "icao": {
            "type": "object",
            "example": "THY"
          },
          "name": {
            "type": "string",
            "example": "Turkish Airlines"
          }
        },
        "required": [
          "iata",
          "name"
        ]
      },
      "CodeshareRef": {
        "type": "object",
        "properties": {
          "carrier": {
            "type": "string",
            "example": "A3"
          },
          "name": {
            "type": "string",
            "example": "Aegean Airlines"
          },
          "flightNumber": {
            "type": "string",
            "example": "3160"
          }
        },
        "required": [
          "carrier",
          "name",
          "flightNumber"
        ]
      },
      "CountryRef": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "TR"
          },
          "name": {
            "type": "string",
            "example": "Turkey"
          },
          "emoji": {
            "type": "string",
            "example": "🇹🇷"
          },
          "flagSvg": {
            "type": "string",
            "example": "https://api.example.com/v1/flags/tr.svg"
          },
          "flagSvgSquare": {
            "type": "string",
            "example": "https://api.example.com/v1/flags/tr.svg?shape=1x1"
          }
        },
        "required": [
          "code",
          "name",
          "emoji",
          "flagSvg",
          "flagSvgSquare"
        ]
      },
      "AirportRef": {
        "type": "object",
        "properties": {
          "iata": {
            "type": "string",
            "example": "IST"
          },
          "icao": {
            "type": "object",
            "example": "LTFM"
          },
          "code": {
            "type": "object",
            "description": "Upstream airport code, may differ from IATA."
          },
          "name": {
            "type": "string",
            "example": "Istanbul Airport"
          },
          "city": {
            "type": "object",
            "example": "Istanbul"
          },
          "state": {
            "type": "object",
            "example": ""
          },
          "country": {
            "$ref": "#/components/schemas/CountryRef"
          },
          "timezone": {
            "type": "object",
            "example": "Europe/Istanbul"
          }
        },
        "required": [
          "iata",
          "name",
          "country"
        ]
      },
      "FlightTime": {
        "type": "object",
        "properties": {
          "utc": {
            "type": "string",
            "example": "2026-09-08T09:10:00.000Z"
          },
          "local": {
            "type": "object",
            "example": "2026-09-08T12:10:00.000"
          },
          "timezone": {
            "type": "object",
            "example": "EEST"
          }
        },
        "required": [
          "utc"
        ]
      },
      "EndpointTimes": {
        "type": "object",
        "properties": {
          "scheduledGate": {
            "$ref": "#/components/schemas/FlightTime"
          },
          "estimatedGate": {
            "$ref": "#/components/schemas/FlightTime"
          },
          "actualGate": {
            "$ref": "#/components/schemas/FlightTime"
          },
          "scheduledRunway": {
            "$ref": "#/components/schemas/FlightTime"
          },
          "estimatedRunway": {
            "$ref": "#/components/schemas/FlightTime"
          },
          "actualRunway": {
            "$ref": "#/components/schemas/FlightTime"
          }
        }
      },
      "FlightEndpoint": {
        "type": "object",
        "properties": {
          "airport": {
            "$ref": "#/components/schemas/AirportRef"
          },
          "terminal": {
            "type": "object",
            "example": "M"
          },
          "gate": {
            "type": "object",
            "example": "A11"
          },
          "baggage": {
            "type": "object",
            "example": "16",
            "description": "Baggage carousel (arrival only)."
          },
          "times": {
            "$ref": "#/components/schemas/EndpointTimes"
          },
          "bestTimeUtc": {
            "type": "object",
            "description": "Best known time: actual, else estimated, else scheduled."
          },
          "delayMinutes": {
            "type": "object",
            "description": "Gate delay in minutes, negative when early."
          }
        },
        "required": [
          "airport",
          "times"
        ]
      },
      "FlightStatusInfo": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "L",
            "description": "Upstream status code (S/A/L/C/D/R/U/NO)."
          },
          "label": {
            "type": "string",
            "example": "Arrived"
          },
          "description": {
            "type": "object",
            "example": "On time"
          },
          "color": {
            "type": "object",
            "example": "green"
          },
          "phase": {
