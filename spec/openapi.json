              "type": "string",
              "enum": [
                "status.changed",
                "flight.departed",
                "flight.arrived",
                "flight.cancelled",
                "flight.diverted",
                "flight.reinstated",
                "departure.gate.changed",
                "departure.terminal.changed",
                "arrival.gate.changed",
                "arrival.terminal.changed",
                "arrival.baggage.changed",
                "departure.scheduled.changed",
                "departure.estimated.changed",
                "departure.actual.changed",
                "arrival.scheduled.changed",
                "arrival.estimated.changed",
                "arrival.actual.changed",
                "delay.increased",
                "delay.decreased",
                "aircraft.changed",
                "aircraft.tail.changed",
                "route.changed",
                "codeshares.changed"
              ]
            }
          },
          "delayThresholdMinutes": {
            "type": "number",
            "example": 1,
            "description": "Ignore delay swings smaller than this."
          },
          "metadata": {
            "type": "object",
            "description": "Opaque data echoed back in every webhook."
