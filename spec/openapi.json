            "type": "object",
            "description": "Extra headers to send with each webhook."
          },
          "metadata": {
            "type": "object",
            "description": "Opaque data echoed back in every webhook."
          }
        },
        "required": [
          "carrier",
          "flightNumber",
          "date",
          "webhookUrl"
        ]
