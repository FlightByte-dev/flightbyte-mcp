      "CreateSubscriptionDto": {
        "type": "object",
        "properties": {
          "carrier": {
            "type": "string",
            "example": "TK"
          },
          "flightNumber": {
            "type": "string",
            "example": "1848"
          },
          "date": {
            "type": "string",
            "example": "2026-09-08"
          },
          "origin": {
            "type": "string",
            "example": "IST",
