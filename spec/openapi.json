            }
          },
          {
            "name": "date",
            "required": true,
            "in": "path",
            "schema": {
              "example": "2026-09-08",
              "type": "string"
            }
          },
          {
            "name": "origin",
            "required": false,
            "in": "query",
            "schema": {
              "example": "IST",
              "type": "string"
            }
          },
          {
            "name": "destination",
            "required": false,
            "in": "query",
            "schema": {
              "example": "JFK",
              "type": "string"
            }
          },
          {
            "name": "flightId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "refresh",
            "required": false,
            "in": "query",
            "schema": {
              "example": "false",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightSnapshot"
                }
              }
            }
          }
        },
        "summary": "Get a flight",
        "tags": [
          "flights"
        ],
        "description": "Fetch a single flight leg by its natural key.",
        "security": [
          {
            "apiKey": []
          }
        ]
      }
    },
