              "type": "string"
            }
          },
          {
            "name": "carrier",
            "required": false,
            "in": "query",
            "schema": {
              "example": "TK",
              "type": "string"
            }
          },
          {
            "name": "flightNumber",
            "required": false,
            "in": "query",
            "schema": {
              "example": "1848",
              "type": "string"
            }
          },
          {
            "name": "date",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-09-08",
              "type": "string"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "example": 0
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "example": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "List subscriptions",
        "tags": [
          "subscriptions"
        ],
        "description": "List subscriptions, newest first.",
        "security": [
          {
            "apiKey": []
          }
        ]
      }
    },
