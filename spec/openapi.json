    "/v1/flights/search": {
      "get": {
        "description": "Serves from the Redis cache when fresh. Concurrent identical searches are coalesced into a single upstream call. When the flight number operates more than one leg that day, pass `origin` (and optionally `destination`) to pick one; without a selector the provider default is returned and every leg is listed under `alternates`.",
        "operationId": "search-flights",
        "parameters": [
          {
            "name": "carrier",
            "required": true,
            "in": "query",
            "description": "Airline IATA/ICAO code.",
            "schema": {
              "example": "TK",
              "type": "string"
            }
          },
          {
            "name": "flightNumber",
            "required": true,
            "in": "query",
            "schema": {
              "example": "1848",
              "type": "string"
            }
          },
          {
            "name": "date",
            "required": true,
            "in": "query",
            "description": "Local departure date at the origin.",
            "schema": {
              "example": "2026-09-08",
              "type": "string"
            }
          },
          {
            "name": "origin",
            "required": false,
            "in": "query",
            "description": "Departure airport, when the flight number operates several legs that day. IATA or the upstream code; both resolve to the same leg.",
            "schema": {
              "example": "IST",
              "type": "string"
            }
          },
          {
            "name": "destination",
            "required": false,
            "in": "query",
            "description": "Arrival airport, to narrow further.",
            "schema": {
              "example": "JFK",
              "type": "string"
            }
          },
          {
            "name": "flightId",
            "required": false,
            "in": "query",
            "description": "Provider flight id from a previous response's `alternates`. Exact match.",
            "schema": {
              "example": "1407266450",
              "type": "string"
            }
          },
          {
            "name": "refresh",
            "required": false,
            "in": "query",
            "description": "Bypass the cache.",
            "schema": {
              "example": "false",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightSnapshot"
                }
              }
            }
          },
          "404": {
            "description": "No such flight, or no leg matching the selector."
          }
        },
        "summary": "Search flights",
        "tags": [
          "flights"
        ],
        "security": [
          {
            "apiKey": []
          }
        ]
      }
    },
    "/v1/flights/{carrier}/{flightNumber}/{date}": {
      "get": {
        "operationId": "get-flight",
