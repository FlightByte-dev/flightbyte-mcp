            "type": "string",
            "example": "2026-09-08"
          },
          "webhookUrl": {
            "type": "string",
            "example": "https://example.com/hooks/flights"
          },
          "secret": {
            "type": "string",
            "example": "whsec_...",
            "description": "HMAC-SHA256 signing secret. Returned in full only at creation."
          },
          "headers": {
            "type": "object",
            "description": "Extra headers sent with every delivery."
